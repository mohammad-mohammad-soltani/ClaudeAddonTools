REPO_URL = "https://github.com/mohammad-mohammad-soltani/ClaudeAddonTools"

SHARE = os.environ.get("CLAUDE_STATUS_SHARE", "/usr/share/claude-status")
HOOK = os.path.join(SHARE, "claude-status-hook.py")
ICON = os.path.join(SHARE, "claude-status.svg")
HOME = os.path.expanduser("~")
CLAUDE_DIR = os.environ.get("CLAUDE_CONFIG_DIR", os.path.join(HOME, ".claude"))
SETTINGS = os.path.join(CLAUDE_DIR, "settings.json")
CONFIG = os.path.join(GLib.get_user_config_dir(), "claude-status")
