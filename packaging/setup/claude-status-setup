PREFS = os.path.join(GLib.get_user_cache_dir(), "claude-status", "prefs.json")
FONT_DIR = os.path.join(GLib.get_user_data_dir(), "fonts", "claude-status")

HOOK_EVENTS = {"SessionStart": 5, "SessionEnd": 5, "UserPromptSubmit": 5, "PreToolUse": 5,
               "PostToolUse": 5, "Notification": 5, "Stop": 5, "PermissionRequest": 120}

